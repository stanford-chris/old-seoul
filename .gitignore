# Harvested photo pools (built by the harvest scripts; large, and they carry the
# mutable `posted` flags, so they are runtime state rather than source)
seoul_archive.json
seoul_dryplate.json
seoul_gazette.json

# Runtime state (last-success timestamp)
seoul_state.json

# Logs
*.log

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# macOS
.DS_Store

# Leftover from an interrupted atomic JSON write (write_json_atomic)
*.json.tmp

# One line per posted item, recording the alt text that shipped and whether it
# was generated or fell back, for skimming output to catch duds (local log)
alt_history.jsonl

# One line per translation-check verdict, the rejected drafts included, for
# reading how often the check fires and whether it was right (local log)
translation_checks.jsonl
